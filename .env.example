# Groq AI API Key for ultra-fast Llama 3 classification
GROQ_API_KEY=gsk_your_groq_api_key_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Secret token to secure Telegram Webhook endpoint
TELEGRAM_WEBHOOK_SECRET=your_secure_random_webhook_secret_here

# Comma-separated list of public Telegram channels to monitor (without @ or with @ or full link)
TELEGRAM_CHANNELS=whackdoor

# Auto-sync polling interval in milliseconds (default: 30000 = 30s)
POLL_INTERVAL_MS=30000
